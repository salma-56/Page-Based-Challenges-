<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="424.0" prefWidth="601.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.reading.challenge.ActiveChallengeController">
   <children>
      <ListView fx:id="activeChallengeList" layoutX="14.0" layoutY="66.0" prefHeight="312.0" prefWidth="574.0" />
      <Text layoutX="14.0" layoutY="38.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Active Challenges" wrappingWidth="170.61328125">
         <font>
            <Font name="System Bold" size="20.0" />
         </font></Text>
      <Button fx:id="backButton" layoutX="20.0" layoutY="388.0" mnemonicParsing="false" onAction="#backToMenu" prefHeight="5.0" prefWidth="63.0" text="Back" />
      <Button fx:id="removeChallengeButton" layoutX="516.0" layoutY="18.0" mnemonicParsing="false" onAction="#removeChallenge" text="Remove">
         <tooltip>
            <Tooltip text="Choose a challenge to remove it!" />
         </tooltip></Button>
      <Text layoutX="14.0" layoutY="56.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Make progress or remove your current challenges!">
         <font>
            <Font size="15.0" />
         </font>
      </Text>
      <Button fx:id="updateButton" layoutX="447.0" layoutY="18.0" mnemonicParsing="false" onAction="#updateChallenge" text="Update">
         <tooltip>
            <Tooltip text="Choose a challenge to update it!" />
         </tooltip></Button>
   </children>
</AnchorPane>
