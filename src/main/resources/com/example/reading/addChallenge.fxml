<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.reading.challenge.AddChallengeController">
   <children>
      <Button fx:id="addChallenge" layoutX="238.0" layoutY="307.0" mnemonicParsing="false" onAction="#addChallenge" prefHeight="32.0" prefWidth="96.0" text="Add" />
      <Button fx:id="backButton" layoutX="35.0" layoutY="361.0" mnemonicParsing="false" onAction="#backToMenu" text="Back" />
      <TextField fx:id="challengeNameField" layoutX="152.0" layoutY="83.0" prefHeight="42.0" prefWidth="267.0" promptText="Challenge Name" />
      <ChoiceBox fx:id="bookChoiceBox" layoutX="152.0" layoutY="137.0" prefHeight="42.0" prefWidth="267.0" />
      <Text layoutX="202.0" layoutY="58.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Create Challenge" wrappingWidth="184.5">
         <font>
            <Font name="System Bold" size="20.0" />
         </font></Text>
      <DatePicker fx:id="endDatePicker" layoutX="152.0" layoutY="254.0" prefHeight="42.0" prefWidth="267.0" promptText="End date" />
      <TextField fx:id="endPageField" layoutX="323.0" layoutY="190.0" prefHeight="42.0" prefWidth="96.0" promptText="End page" />
      <TextField fx:id="startPageField" layoutX="151.0" layoutY="190.0" prefHeight="42.0" prefWidth="96.0" promptText="Start Page" />
      <Button fx:id="randomiseButton" layoutX="55.0" layoutY="137.0" mnemonicParsing="false" onAction="#randomiseBook" prefHeight="42.0" prefWidth="81.0" text="Randomise">
         <tooltip>
            <Tooltip text="Press this button to randomly choose a book!" />
         </tooltip></Button>
      <Label fx:id="challengeNameAsterisk" layoutX="428.0" layoutY="96.0" text="Label" />
      <Label fx:id="bookAsterisk" layoutX="428.0" layoutY="150.0" text="Label" />
      <Label fx:id="pagesAsterisk" layoutX="428.0" layoutY="203.0" text="Label" />
      <Label fx:id="dateAsterisk" layoutX="428.0" layoutY="267.0" text="Label" />
      <Line endX="53.0" endY="-1.0" layoutX="270.0" layoutY="212.0" startX="-23.0" startY="-1.0" stroke="PINK" />
      <Label fx:id="confirmationLabel" layoutX="118.0" layoutY="351.0" prefHeight="20.0" prefWidth="451.0" textAlignment="CENTER">
         <font>
            <Font size="14.0" />
         </font></Label>
      <Button fx:id="reset" layoutX="70.0" layoutY="188.0" mnemonicParsing="false" onAction="#reset" text="Reset" />
      <Label fx:id="counterLabel" layoutX="456.0" layoutY="37.0" prefHeight="25.0" prefWidth="121.0" text="Counter: ">
         <tooltip>
            <Tooltip text="Displays the number of randomiser attempts remaining" />
         </tooltip>
      </Label>
   </children>
</AnchorPane>
