<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.reading.readingList.ReadingController">
   <children>
      <Button fx:id="addBook" layoutX="507.0" layoutY="75.0" mnemonicParsing="false" onAction="#onAddBook" prefHeight="32.0" prefWidth="59.0" text="Add" />
      <Button fx:id="removeBook" layoutX="507.0" layoutY="122.0" mnemonicParsing="false" onAction="#onRemoveBook" prefHeight="32.0" prefWidth="59.0" text="Remove" />
      <TableView fx:id="tableOfBooks" layoutY="-1.0" prefHeight="400.0" prefWidth="489.0">
        <columns>
          <TableColumn fx:id="bookTitleCol" prefWidth="111.0" text="Book Title" />
          <TableColumn fx:id="authorNameCol" prefWidth="140.0" text="Author Name" />
        </columns>
      </TableView>
   </children>
</AnchorPane>
